{
  "name": "a2z-sheet-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the A2Z DSA Sheet tracker (Express + MongoDB)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/scripts/seed.js",
    "validate:data": "node src/scripts/validateData.js",
