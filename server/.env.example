# Copy this file to .env and adjust values.  Never commit your real .env.

NODE_ENV=development
PORT=5000

# Local MongoDB (default install) or a MongoDB Atlas connection string:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/a2z_sheet?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/a2z_sheet

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated list of browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# Seed the problem collection automatically on start-up when it is empty.
AUTO_SEED=true
